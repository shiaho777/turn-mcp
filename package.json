{
  "name": "turn-mcp-web",
  "version": "0.1.0",
  "description": "MCP server + browser console providing turn.wait human-in-the-loop checkpoint for AI agents.",
  "main": "dist/server.js",
  "bin": {
    "turn-mcp-web": "./dist/server.js",
    "turn-mcp-web-stdio": "./dist/server-stdio.js"
  },
  "files": [
    "dist",
    "public",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "prepublishOnly": "npm run build",
    "start": "node dist/server.js",
    "dev": "tsc -w -p ./",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "human-in-the-loop",
    "ai-agent",
    "turn-wait",
    "checkpoint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiahonb777/turn-mcp"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
